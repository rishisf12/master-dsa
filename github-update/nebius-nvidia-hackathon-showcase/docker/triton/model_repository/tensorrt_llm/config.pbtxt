# Triton Inference Server Model Configuration for TensorRT-LLM
# See: https://github.com/triton-inference-server/tensorrtllm_backend

name: "tensorrt_llm"
backend: "tensorrtllm"
max_batch_size: 32

input [
  {
    name: "input_ids"
    data_type: TYPE_INT32
    dims: [-1, -1]
  },
  {
    name: "input_lengths"
    data_type: TYPE_INT32
    dims: [-1, 1]
  },
  {
    name: "request_output_len"
    data_type: TYPE_UINT32
    dims: [1, 1]
    optional: true
  },
  {
    name: "runtime_top_k"
    data_type: TYPE_UINT32
    dims: [1, 1]
    optional: true
  },
  {
    name: "runtime_top_p"
    data_type: TYPE_FP32
    dims: [1, 1]
    optional: true
  },
  {
    name: "beam_search_diversity_rate"
    data_type: TYPE_FP32
    dims: [1, 1]
    optional: true
  },
  {
    name: "temperature"
    data_type: TYPE_FP32
    dims: [1, 1]
    optional: true
  },
  {
    name: "len_penalty"
    data_type: TYPE_FP32
    dims: [1, 1]
    optional: true
  },
  {
    name: "repetition_penalty"
    data_type: TYPE_FP32
    dims: [1, 1]
    optional: true
  },
  {
    name: "random_seed"
    data_type: TYPE_UINT64
    dims: [1, 1]
    optional: true
  },
  {
    name: "is_return_log_probs"
    data_type: TYPE_BOOL
    dims: [1, 1]
    optional: true
  },
  {
    name: "prompt_learning_task_name_ids"
    data_type: TYPE_INT32
    dims: [1, 1]
    optional: true
  },
  {
    name: "prompt_vocab_size"
    data_type: TYPE_UINT32
    dims: [1, 1]
    optional: true
  },
  {
    name: "lora_task_id"
    data_type: TYPE_UINT32
    dims: [1, 1]
    optional: true
  },
  {
    name: "lora_weights"
    data_type: TYPE_FP32
    dims: [1, 1]
    optional: true
  },
  {
    name: "lora_config"
    data_type: TYPE_INT32
    dims: [1, 1]
    optional: true
  }
]

output [
  {
    name: "output_ids"
    data_type: TYPE_INT32
    dims: [-1, -1]
  },
  {
    name: "sequence_length"
    data_type: TYPE_INT32
    dims: [-1, 1]
  },
  {
    name: "cum_log_probs"
    data_type: TYPE_FP32
    dims: [-1, 1]
    optional: true
  },
  {
    name: "output_log_probs"
    data_type: TYPE_FP32
    dims: [-1, -1, -1]
    optional: true
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [0]
  }
]

model_repository {
  tensorrt_llm {
    # Model configuration
    model_dir: "/models/tensorrt_llm/1"
    
    # Engine configuration
    max_batch_size: 32
    max_input_len: 4096
    max_output_len: 2048
    max_beam_width: 1
    
    # Precision
    dtype: "fp8"
    
    # Parallelism
    tensor_parallel_size: 1
    pipeline_parallel_size: 1
    
    # KV Cache
    max_tokens_in_paged_kv_cache: 8192
    kv_cache_free_gpu_mem_fraction: 0.9
    
    # Speculative decoding
    speculative_decoding_mode: "none"
    
    # Batching
    scheduler_policy: "max_utilization"
    
    # Logging
    log_level: "info"
  }
}

parameters {
  key: "model_dir"
  value {
    string_value: "/models/tensorrt_llm/1"
  }
}

parameters {
  key: "tokenizer_dir"
  value {
    string_value: "/models/tensorrt_llm/1"
  }
}

parameters {
  key: "max_batch_size"
  value {
    string_value: "32"
  }
}

parameters {
  key: "max_input_len"
  value {
    string_value: "4096"
  }
}

parameters {
  key: "max_output_len"
  value {
    string_value: "2048"
  }
}

parameters {
  key: "max_beam_width"
  value {
    string_value: "1"
  }
}

# Optimization profiles for dynamic batching
optimization {
  priority: PRIORITY_MAX
  input_padding {
    input_name: "input_ids"
    padding: PADDING_NONE
  }
}

# Response cache (optional)
response_cache {
  enable: true
  max_cache_size_bytes: 1073741824  # 1GB
}