# =============================================================================
# Nebius x NVIDIA Global AI Hackathon 2026 - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# NVIDIA Configuration
# Get API keys from: https://build.nvidia.com/
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_ORG=your_org_name

# NIM Models to use (see https://build.nvidia.com/explore/discover)
NIM_LLM_MODEL=meta/llama3-70b-instruct
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NIM_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# TensorRT-LLM Optimization
TENSORRT_LLM_ENABLED=true
TENSORRT_LLM_QUANTIZATION=fp8  # fp8, int4, awq
TENSORRT_LLM_MAX_BATCH_SIZE=32
TENSORRT_LLM_MAX_INPUT_LEN=4096
TENSORRT_LLM_MAX_OUTPUT_LEN=2048

# -----------------------------------------------------------------------------
# Nebius AI Cloud Configuration
# Get credentials from: https://console.nebius.com/
# -----------------------------------------------------------------------------
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_PROJECT_ID=your_project_id
NEBIUS_CLUSTER_ID=your_cluster_id
NEBIUS_REGION=us-east-1  # or eu-west-1

# GPU Instance Types (for scaling)
NEBIUS_GPU_TYPE=h100  # h100, a100, l40s
NEBIUS_GPU_COUNT=1

# -----------------------------------------------------------------------------
# Vector Database (Qdrant)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional, for Qdrant Cloud
QDRANT_COLLECTION_NAME=hackathon_knowledge_base
QDRANT_VECTOR_SIZE=1024  # Matches embedding model
QDRANT_DISTANCE=Cosine

# -----------------------------------------------------------------------------
# Redis (Caching & Queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=  # Optional
REDIS_DB=0

# -----------------------------------------------------------------------------
# Triton Inference Server
# -----------------------------------------------------------------------------
TRITON_URL=http://localhost:8000
TRITON_GRPC_URL=localhost:8001
TRITON_MODEL_REPOSITORY=./docker/triton/model_repository

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
ENVIRONMENT=development  # development, staging, production

# API Security
API_KEY_ENABLED=false
API_KEY=your_api_key_here
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
# LangSmith (for LLM tracing)
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=nebius-nvidia-hackathon
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Prometheus/Grafana
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000

# Custom Metrics
METRICS_PREFIX=hackathon

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4096

# RAG Configuration
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_RERANK_TOP_K=3

# Guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_CONFIG_PATH=./config/guardrails

# -----------------------------------------------------------------------------
# External APIs (Optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=  # Fallback
ANTHROPIC_API_KEY=  # Fallback
GOOGLE_API_KEY=  # For Gemini

# -----------------------------------------------------------------------------
# Development / Debug
# -----------------------------------------------------------------------------
DEBUG_SQL=false
MOCK_NIM=false  # Set true for local dev without GPU
MOCK_TRITON=false